    // Fetch and display all books
    $sql = "SELECT * FROM bookdetails";
    $result = $conn->query($sql);

    if ($result->num_rows > 0) {
        while($row = $result->fetch_assoc()) {
            echo "<tr>
                    <td>{$row['bookno']}</td>
                    <td>{$row['title']}</td>
                    <td>{$row['edition']}</td>
                    <td>{$row['publisher']}</td>
                  </tr>";
        }
    } else {
        echo "<tr><td colspan='4'>No books found.</td></tr>";
    }

    $conn->close();
